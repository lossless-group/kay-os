{
  // kay-os.lol: the built splash (dist/), served as static assets by a Worker
  // with no code. Build and deploy with ./deploy.sh, which builds for
  // https://kay-os.lol (base "/") and passes the kay-os.lol OpenPanel client.
  // The GitHub Pages copy keeps building separately from .github/workflows.
  "name": "kay-os-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // kay-os.lol is a zone in this Cloudflare account, so Cloudflare makes the
  // DNS records and certificates for both names.
  "routes": [
    { "pattern": "kay-os.lol", "custom_domain": true },
    { "pattern": "www.kay-os.lol", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
