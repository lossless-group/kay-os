{
  "name": "kay-os-mail-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No public URL: the worker only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "kay-os-mail" }],
  "durable_objects": { "bindings": [{ "name": "SYNC", "class_name": "MailboxSync" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxSync"] }],
  "observability": { "enabled": true }
}
